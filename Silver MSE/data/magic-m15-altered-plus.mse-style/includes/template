dummy := {"dummy"}
harder_script := [
	dummy: dummy
]
template_normal      := { 
    crown_lead(
        type
    ) 
    + template_prefix()[type] 
    + input + crown_follow(
        type
    ) 
    + template_suffix[type] 
}
template := { 
	if type_name(harder_script[type] or else nil) != type_name(nil)
		then harder_script[type](input, land:false)
	else template_normal(input, type: type)
}
land_template := { 
    crown_lead(
        type
    ) 
    + template_prefix()[type] 
    + (
        if input == "a" 
        then "c" 
        else input
    ) 
    + (
        if landless(
            type
        ) 
        then "" 
        else "l"
    ) 
    + crown_follow(
        type
    ) 
    + template_suffix[type] 
}
# Use land templates for previews because they show more contrast
hybrid_previews := "land,hybrid"

landless := {
    if input == "nyx"
    or input == "star"
    or input == "hands"
    or input == "universesbeyond"
    or input == "voyager"
    or input == "backdfc"
    or input == "space"
    or input == "path"
    or input == "lush"
    or input == "smallbox"
    or input == "sky"
    or input == "frontier"
    or input == "pins"
    or input == "node"
    or input == "miracle"
    or input == "ubstamp"
    or input == "alias"
    or input == "alias2"
    or input == "devoid"
    or input == "devoid2"
    or input == "energy"
    or input == "halfart"
    or input == "season"
    or input == "front"
    or input == "back"
    or input =="pop"
    or input == "cpop1"
    or input == "cpop2"
    or input == "cpop3"
    or input == "cpop4"
    or input == "cpop5"
    or input == "pro"
    or input == "adventure2"
    or input == "adventure4"
    or input == "focus"
    or input == "focus2"
    or input == ""
    or input == "cons"
    or input == "arrow"
    or input == "crown"
    or input == "nyxcrown"
    or input == "starcrown"
    or input == "spacecrown"
        then true else false
}