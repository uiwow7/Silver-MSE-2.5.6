crown:
	left: 0
	top: {if is_devoid() or is_devoid2() then 1 else 0}
	width: 375
	height: 523
	render style: image
	image: {if (is_clear() or clear_tops()) and not is_devoid() or is_devoid2() then "modules/legend/xcrown.png" else if is_fnm() then set_mask(image:crown_background(), mask:"modules/legend/fnm_mask.png") else module_crown()}
	z index: 128
	visible: {is_legend() and not is_map() and not use_porthole()}
	mask: {if is_legend() and card.crown_type != "custom" and (is_curtains() or is_puma() or is_devoid() or is_devoid2() or is_oldYGO()) then "imagemasks/curtainmask.png" else if is_season() then "crown_season_mask.png" else if use_ocean() then "imagemasks/crown_voyager.png" else ""}
curtain:
	left: 0
	top: 0
	width: 375
	height: 523
	render style: image
	image: {if is_cons() then cons_background() else curtain_background()}
	z index: 100
	visible: {is_cons() or is_curtains()}
	mask: {if is_legend() and is_curtains() then "limagemasks/curtainmask.png"}
scrolls:
	left: 0
	top: 0
	width: 375
	height: 523
	render style: image
	image: {if is_puma() then "modules/extras/puma.png" else ("trims/conspiracy/" + if is_full_art() then "full_" else "") + "consscrolls.png"}
	mask: {if is_puma() then "imagemasks/puma_mask3.png" else ""}
	z index: 110
	visible: {is_scrolls() or is_puma()}
miracle overlay:
	left: 0
	top: 0
	width: 375
	height: 523
	render style: image
	image: {if (is_clear() or clear_tops()) and not is_devoid() or is_devoid2() then "modules/miracles/xmiracle.png" else miracle_background()}
	z index: 110
	visible: {is_miracle()}
season flag:
	left: 0
	top: 0
	width: 375
	height: 523
	z index: 130
	render style: image
	image: { season_background() }
	visible: { is_season() }
	mask: {if is_expanded_art() then "season/full_mask.png" else ""}
special guest overlay:
	left: 0
	top: 0
	width: 375
	height: 523
	z index: 120
	render style: image
	image: modules/extras/specialguest_overlay.png
	visible: {is_specialguest()}
readable overlay:
	left: 0
	top: 0
	width: 375
	height: 523
	z index: 120
	render style: image
	image: modules/extras/readable_overlay.png
	visible: {is_readable()}