pt box:
	left: 
		script:
			if is_leveler() 
			and not lone_pt() 
				then leveler_ptbox_left() 
			else if is_map() 
				then 270 
			else 273
	top:  
		script: 
			if is_leveler() 
			and not lone_pt() 
				then (
					l1_center() 
					- (
						if is_map() 
							then 26 
						else 18
					)
					+ leveler_ptbox_top_offset()
				) 
			else if is_halfart() 
			or is_thbland() 
				then 476 
			else if is_map() 
				then 453 
			else if use_porthole() 
				then 460 
			else 466
	width:  
		script:
			if starting_loyalty() 
			and not is_leveler() 
				then 0 
			else if is_map() 
				then 90 
			else leveler_ptbox_width()
	height:	 
		script:
			if is_map() 
				then 54 
			else leveler_ptbox_height()
	z index: 140
	visible: { card.pt != "" and not is_old() }
	render style: image
	image: 
		script: 
			if is_map() 
				then mappt_background()
			else if space_leveler() 
				then station_ptbox()
			else if is_vehicle() 
			and (
				not is_legend() 
				or chosen(
					styling.other_options, 
					choice:"brown legendary vehicle pt"
				)
			) 
				then "trims/vehicle/vpt.png" 
			else if is_familiar() 
			or is_familiarpt() 
				then "trims/familiar/fmpt.png" 
			else if is_clear() 
			and not is_backdfc() 
				then "cards/normal/cpt.png" 
			else if use_gold() 
				then "cards/gold/goldpt.png" 
			else if is_backdfc() 
				then pt2() 
			else if use_porthole() 
				then "cards/voyager/portholept.png" 
			else choose_ptbox() 
	
pt box 2:
	left: {leveler_ptbox_left()}
	top: { l2_center() - (if is_map() then 26 else 15) + leveler_ptbox_top_offset()}
	width: { if (is_leveler() and not lone_pt()) or card.pt_2 != "" then (if is_map() then 90 else leveler_ptbox_width()) else 0}
	height:	{ if (is_leveler() and not lone_pt()) or card.pt_2 != "" then (if is_map() then 54 else leveler_ptbox_height()) else 0}
	z index: 130
	visible: { card.pt_2 != "" and not is_prototype() }
	render style: image
	image: {if is_map() then mappt_background() else if space_leveler() then station_ptbox() else combine_blend(image1: lv_2_ptbox(), image2: "modules/extras/ptbox_multiply_1.png", combine: "multiply")}
