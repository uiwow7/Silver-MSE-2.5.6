flavor bar:
	left: 
		script:
			if is_reversed() 
			then 10 
			else if is_altcast() 
			then 175 
			else if flavor_plate() 
			then 27 
			else 0
	top: {bar_equation()}
	width: 
		script:
			if is_altcast() 
			then 188 
			else if flavor_plate() 
			then 317 
			else 375
	height: 
		script: if flavor_plate() 
		then (
			484 
			- bar_equation()
		) 
		else 1
	z index: 120
	render style: image
	image: 
		script:
			if is_altcast() 
			then "modules/extras/altflav.png"
			else if flavor_plate() 
			then crop(
				"flavorframe.png", 
				height: clamp(
					484 - bar_equation(), 
					minimum: 1, 
					maximum: 154
				),
					width:317, 
					offset_x: 0, 
					offset_y: 0
			) 
			else "modules/extras/bar.png"
	visible: 
		script:
			card.rule_text != "" 
			and remove_tags(
				card.flavor_text
			) != "" 
			and set.use_flavor_bar 
tarot watermark:
	left: { if is_map() then 40 else 19 }
	top: { if is_full_art() then 359 else 330 }
	width: { if not is_tarot() then 0 else if is_map() then 287 else 334 }
	height: { if is_map() then 154 else if is_full_art() then 120 else 152 }
	z index: 120
	alignment: middle center
	font:
		name: MPlantin
		size: 90
		color: {rgba(0,0,0,40)}

