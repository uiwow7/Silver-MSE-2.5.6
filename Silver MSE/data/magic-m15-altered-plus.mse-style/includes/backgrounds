main_background := { 
	if is_clear() 
		or clear_tops() 
		or use_porthole() 
		or use_styles() 
		or use_ocean()
			then "" 
	else if is_fnm() 
		then fnm_background() 
	else if is_inverted() 
		then inverted_background() 
	else if is_paradox() 
		then paradox_background() 
	else if is_full_art() 
		then promo_background() 
	else if pure_snow() 
		then snow_background() 
	else if is_adventure() 
		then adventure_colors() 
	else if is_adventure2() 
		then adventure2_colors() 
	else if is_ub() 
		then ub_background() 
	else if is_saga() 
		then saga_background() 
	else if is_old()
		then old_background()
	else card_background() 
}

