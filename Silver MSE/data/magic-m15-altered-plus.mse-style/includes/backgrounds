crown_lead := {
	if input != "crown" 
	then ""
	else if (
		card.crown_type == "custom" 
		and styling.custom_crown_location != ""
	)
		then "/magic-mainframe-extras.mse-include/" 
		+ styling.custom_crown_location
	else ""
}
crown_follow := {
	if input != "crown" 
		then ""
	else if card.crown_type == "nyx"
		then "nyx"
	else if card.crown_type == "star"
		then "star"
	else if card.crown_type == "space" 
		then "space"
	else if card.crown_type == "companion"
		then "com"
	else ""
}

mv_split := break_text@(
	match: 
	"(?ix) 1/2 | [|][WUBRGICX] | [0-9](/[WUBRGCVLHSICETQ2X]) | [0-9]+(?!/[WUBRGCVLHSICETQ2X]) | [WUBRGCVLHSI0-9X](/[WUBRGCVLHSIX])\{0,4} "
)
number_of_symbols := { 
	length(
		mv_split(
			card.casting_cost_2
		)
	) 
}

prototype_cost := {
		if number_of_symbols() < 2 
			then color_background(
				type:"cpop1",
				base_hybrid:pt_hybrid
			) 
		else if number_of_symbols() == 2 
			then color_background(
				type:"cpop2",
				base_hybrid:pt_hybrid
			) 
		else if number_of_symbols() == 3 
			then color_background(
				type:"cpop3",
				base_hybrid:pt_hybrid
			) 
		else if number_of_symbols() == 4 
			then color_background(
				type:"cpop4",
				base_hybrid:pt_hybrid
			) 
		else color_background(
			type:"cpop5",
			base_hybrid:pt_hybrid
		)
}

transfer_levels     := {
