multi_scale := [0, 0.35, 0.7, 0.9, 1.0, 1.2, 1.5, 1.8, 2.0, 2,2, 2.5, 2.8, 3.0]
multiply_levels := {
	bump := 0
	start := 1
	end := 3
	crop_width := if is_notched() then 375 else 346
	level_map := [
		[coord:0, height:lv_1_height()],
		[coord:lv_2_coordinate(), height:lv_2_height()],
		[coord:lv_3_coordinate(), height:lv_3_height()],
		[coord:lv_4_coordinate(), height:lv_4_height()]
	]
	if not is_leveler() then (
		level_map := [
			[],
			[coord: 0, height: 152]
		]
		end := 1
	)
	if is_leveler() and is_back_face() then (
		start := 0
		bump := 1
	)
	mask := "multiply_mask_canvas.png"
	for x from start to end do (
		lv_info := level_map[x]
		if lv_info.height <= 0 then "" else (
			lv_top := 329 + lv_info.coord

			cropped := crop_image(
				"multiply_mask_levels.png",
				height: lv_info.height,
				width: crop_width,
				offset_x: 0,
				offset_y: lv_top
			)
			mask := insert_image(
				base_image: mask,
				inserted_image: set_alpha(cropped, alpha:multi_scale[x+bump]),
				offset_x: 0,
				offset_y: lv_top
			)
			"dummy return"
		)
	)
	mask
}

