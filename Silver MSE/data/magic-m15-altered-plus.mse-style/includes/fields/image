image 2:
	left: {if comma_count(styling.popunder_image_style) == ",,,," then split_text(match:",", styling.popunder_image_style).0 else if is_YGO() and not is_nopopout() and not is_YGO() then 89.7 else if is_YGO() then 73 else "0"}
	top: {if comma_count(styling.popunder_image_style) == ",,,," then split_text(match:",", styling.popunder_image_style).1 else if is_YGO() and not is_nopopout() and not is_YGO() then 77.3 else if is_halfart() and is_YGO() and not is_nopopout() then 106.3 else if is_YGO() then 61 else "0"}
	width: {if comma_count(styling.popunder_image_style) == ",,,," then split_text(match:",", styling.popunder_image_style).2 else if is_YGO() and not is_nopopout() and not is_YGO() then 194 else if is_YGO() then 227.7 else "0"}
	height: {if comma_count(styling.popunder_image_style) == ",,,," then split_text(match:",", styling.popunder_image_style).3 else if is_YGO() and not is_nopopout() and not is_YGO() then 196 else if is_YGO() then 227.7 else "0"}
	z index: 129