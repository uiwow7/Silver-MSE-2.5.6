	top: {if is_mutate() then 329 else if is_saga() then chapter0() else top_of_textbox()}
	right: { if is_leveler() then (if lone_pt() or card.pt == "" then 342 else 277) else if is_mutate() then 342 else if is_map() then 40 else if is_saga() then 186 else 29}
	bottom: { if is_mutate() then 392 else if is_leveler() then (327+lv_1_height()) else if is_saga() then split_12() else bottom_of_textbox() }
