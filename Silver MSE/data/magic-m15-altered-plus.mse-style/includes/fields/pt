pt:
	z index: 150
	left: {if is_leveler() and not lone_pt() then leveler_pt_left() else 286}
	top: { if is_leveler() and not lone_pt() then (l1_center() - 14 + leveler_pt_top_offset()) else if is_halfart() or is_thbland() then 479 else if is_map() then 467 else if use_porthole() then 463 else if is_old() then 476 else 469}
	width: {if starting_loyalty() and not is_leveler() then 0 else leveler_pt_width()}
	height: {leveler_pt_height()}
	alignment: center middle shrink-overflow
	font:
		name: { if is_old() then "MPlantin-Bold" else "Beleren Bold" }
		size: {if is_map() then 14 else if is_old() then 18 else if space_leveler() then 13 else 16}
		color: {if is_shifted() and not black_name() or is_fnm() or is_inverted() or space_leveler() or is_familiar() or is_familiarpt() or is_paradox() then "white" else if is_vehicle() and (not is_legend() or chosen(styling.other_options, choice:"brown legendary vehicle pt")) then "white" else if is_backdfc() or is_old() then "white" else "black"}
		separator color: red
		shadow color: {if is_shifted() and not black_name() or is_fnm() or is_old() then rgb(0,0,0) else rgba(0,0,0,0)}
		shadow displacement x: -1
		shadow displacement y: 1

pt 2:
	z index: 160
	left: {leveler_pt_left()}
	top: {if is_prototype() and not is_mutate() then 355 else if is_prototype() and is_mutate() then 422.2 else (l2_center() - 12 + leveler_pt_top_offset())}
	width: {if is_leveler() and not lone_pt() or card.pt_2 != "" then leveler_pt_width() else if is_prototype() then leveler_pt_width() else 0}
	height: {leveler_pt_height()}
	alignment: center middle shrink-overflow
	font:
		name: Beleren Bold
		size: {if is_map() or is_prototype() then 14 else if space_leveler() then 13 else 16}
		color: {if is_shifted() and not black_name() or is_fnm() or is_inverted() or space_leveler() or is_familiar() or is_paradox() or is_prototype() then "white" else if is_vehicle() and (not is_legend() or chosen(styling.other_options, choice:"brown legendary vehicle pt")) then "white" else "black"}
		separator color: red
		shadow color: {if is_prototype() then rgb(0,0,0) else rgba(0,0,0,0)}
		shadow displacement x: 1
		shadow displacement y: 1
