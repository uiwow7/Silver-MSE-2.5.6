mse version: 2.5.0
short name: Atti Exporter
full name: List
position hint: 100
icon: icon.png
version: 2024-09-23
installer group: magic/Export/atti

depends on:
	package: magic.mse-game
	version: 2009-07-23

game: magic
create directory: false
file type: *.txt|*.txt|*.*|*.*

# By Aanginer

script:
	exporter_name_filter := filter_text@(match:"!exporte?r?name [^\n\<]+")
	exporter_name_grabber := replace@(match:"!exporte?r?name ", replace:"")
	card_name := { if exporter_name_grabber(exporter_name_filter(card.notes)) != "" then exporter_name_grabber(exporter_name_filter(card.notes)) else remove_tags(card.name) }
	card_artist := { remove_tags(card.illustrator) }

	write_card := { "{card_number()} {rarity_code()} {card_name()} @{card_artist()}\n" }
	write_cards := { to_text(for each card in cards do write_card()) }

	to_string(write_cards())
