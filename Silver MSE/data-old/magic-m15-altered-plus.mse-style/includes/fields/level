level 0:
	z index: 170
	left: {if box_leveler() then 8 else if loy_leveler() then 14 else if space_leveler() then 14 else 21}
	top: {l1_center() - (if aug_leveler(0) then 4 else 2) - (if center_label(0) then 6 else 0) + arrow_offset(0) - (if space_leveler() then 10 else 0)}
	width: {if is_leveler() or card.level_0 != "" then (34 + (if box_leveler() then 30 else 0) - (if space_leveler() then 10 else 0)) else 0}
	height:	22
	alignment: center middle shrink-overflow
	font:
		name: Beleren Bold
		size: {if loy_leveler() then 11 else 12 + if center_label(0) then 2 else 0}
		weight: bold
		color: {if loy_leveler() or space_leveler() then "white" else "black"}
		shadow color: { if loy_leveler() or space_leveler() then rgba(0,0,0,0) else "white"}
		shadow blur: 2
	symbol font:
		name: { styling.level_mana_symbols }
		size: {12 + if center_label(0) then 0.5 else 0}
